<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="Testmap_2.net.xml"/>
        <route-files value="Testmap_2.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="0.05"/>
    </time>

    <random>
        <seed value="12345"/>
    </random>
    
    <processing>
        <lateral-resolution value="0.7"/>
        <collision.action value="warn"/>
        <time-to-teleport value="60"/>
    </processing>

    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
    </report>
</configuration>
